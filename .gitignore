# Dart
# Ignore everything under .dart/ by default, then un-ignore the committed bridge
# contract: the generated Dart surface consumed by Cake Wallet. Tooling noise
# (.dart_tool/, pubspec.lock) stays ignored.
.dart/*
!.dart/pubspec.yaml
!.dart/api/
!.dart/api/**
!.dart/frb_generated.dart
!.dart/frb_generated.io.dart
!.dart/frb_generated.web.dart
!.dart/lib.dart
